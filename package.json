{
  "name": "tus-dabergotz",
  "version": "0.1.0",
  "private": true,
  "description": "Onepager des TuS Dabergotz – statisches Frontend-Mockup als Vorstufe zum WordPress-Theme",
  "scripts": {
    "dev": "tailwindcss -i ./src/css/tailwind.css -o ./assets/css/tailwind.css --watch",
    "build": "tailwindcss -i ./src/css/tailwind.css -o ./assets/css/tailwind.css --minify",
    "serve": "npx serve ."
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.7",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4"
  }
}
